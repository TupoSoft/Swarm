#!/usr/sbin/nft -f

define allowed_interfaces = { {{ allowed_interfaces | map('to_json') | join(', ') }} }

{% macro docker_user_rules(family) %}
    set allowed_interfaces {
        type ifname
        elements = $allowed_interfaces
    }

    chain DOCKER-USER {
        udp sport 53 counter return
        ct state related,established counter return
        iifname @allowed_interfaces counter return
        tcp dport 443 counter return
        log prefix "dropped in {{ family }} filter DOCKER-USER: " counter drop
    }
{% endmacro %}

table ip filter {
    {{ docker_user_rules('ip') }}
}

table ip6 filter {
    {{ docker_user_rules('ip6') }}
}
