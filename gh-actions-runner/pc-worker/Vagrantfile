require "yaml"

unless Vagrant::Util::Platform.wsl? && ENV["VAGRANT_WSL_ENABLE_WINDOWS_ACCESS"] == "1"
  abort "Run ./vagrant-wsl from WSL using the Linux Vagrant installation."
end

repository = File.expand_path("../..", __dir__)
local_settings = File.join(__dir__, "worker.local.yml")
settings = File.exist?(local_settings) ? YAML.safe_load_file(local_settings) : {}
abort "worker.local.yml must contain a mapping of public VPN settings" unless settings.is_a?(Hash)

Vagrant.configure("2") do |config|
  config.vm.box = "gusztavvargadr/ubuntu-server-2404-lts"
  config.vm.box_version = "2607.0.0"
  config.vm.box_architecture = "amd64"
  config.vm.hostname = "pc-swarm-worker"

  # Existing VMs use the Linux key copy for OpenSSH. A new VM must still let
  # Vagrant replace the box's initial key before the first Ansible run.
  generated_key = File.join(ENV.fetch("VAGRANT_DOTFILE_PATH"), "machines/default/hyperv/private_key")
  linux_key = ENV["PC_WORKER_VAGRANT_SSH_KEY"]
  config.ssh.private_key_path = linux_key if linux_key && File.file?(generated_key)

  # Select the existing Windows NAT switch; Hyper-V supplies the guest address.
  config.vm.network "public_network", bridge: "Default Switch", auto_config: false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "hyperv" do |hyperv|
    hyperv.vmname = "pc-swarm-worker"
    hyperv.cpus = 6
    hyperv.memory = 12288
    hyperv.maxmemory = nil
    hyperv.auto_start_action = "Nothing"
    hyperv.auto_stop_action = "ShutDown"
  end

  config.vm.provision "ansible" do |ansible|
    ansible.playbook = File.join(repository, "ansible/playbooks/pc-worker.yml")
    ansible.config_file = File.join(repository, "ansible/ansible.cfg")
    ansible.galaxy_role_file = File.join(repository, "ansible/requirements.yml")
    ansible.galaxy_roles_path = File.join(repository, "ansible/.roles")
    ansible.playbook_command = File.join(__dir__, "ansible-playbook-wsl")
    ansible.extra_vars = settings
  end
end
