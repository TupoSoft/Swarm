Vagrant.configure("2") do |config|
  config.vm.box = "gusztavvargadr/ubuntu-server-2404-lts"
  config.vm.box_version = "2607.0.0"
  config.vm.box_architecture = "amd64"
  config.vm.hostname = "pc-swarm-worker"

  # Select the existing Windows NAT switch; Hyper-V supplies the guest address.
  config.vm.network "public_network", bridge: "Default Switch", auto_config: false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "hyperv" do |hyperv|
    hyperv.vmname = "pc-swarm-worker"
    hyperv.cpus = 6
    hyperv.memory = 12288
    hyperv.maxmemory = nil
    hyperv.auto_start_action = "Nothing"
    hyperv.auto_stop_action = "ShutDown"
  end

  config.vm.provision "shell", path: "bootstrap.sh"
  config.vm.provision "file", source: "configure-vpn.sh", destination: "/tmp/configure-vpn.sh"
  config.vm.provision "shell", inline: "install -m 0755 /tmp/configure-vpn.sh /usr/local/sbin/configure-swarm-vpn"
end
